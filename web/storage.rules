rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Expense files (images, audio) ────────────────────────
    // Path: expenses/{timestamp}-{hex}/{filename}
    // Server uploads via Admin SDK (bypasses rules).
    // Read: allowed for authenticated users (providers).
    // Public read is handled via download token URLs — these
    // bypass rules entirely, so unauthenticated clients can
    // still view files shared by the provider.
    // Write: denied from client SDKs (only server uploads).
    match /expenses/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Project images (items, proposals) ────────────────────
    // Path: projects/{projectId}/items/{itemId}/{imageId}(_thumb).jpg
    //       projects/{projectId}/proposals/{proposalId}/{imageId}(_thumb).jpg
    // Server uploads via Admin SDK after validating project participation.
    // Read: download token URLs bypass rules, so unauthenticated clients
    // with a share link can still see images. Authenticated users can also
    // read directly.
    // Write: denied from client SDKs (only server uploads).
    match /projects/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
