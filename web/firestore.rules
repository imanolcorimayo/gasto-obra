rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper ───────────────────────────────────────────────
    // Returns true when the calling user is a participant
    // (provider or joined client) of the given project.
    function isProjectParticipant(projectId) {
      let proj = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return request.auth.uid == proj.providerId
          || request.auth.uid == proj.clientUserId;
    }

    // ── Projects ──────────────────────────────────────────────
    // Read: auth required, scoped to provider or joined client.
    // Public preview (shareToken lookup) is served by the API server
    // which uses Admin SDK and returns only non-sensitive fields.
    match /projects/{projectId} {
      allow read: if request.auth != null
                  && (resource.data.providerId == request.auth.uid
                      || resource.data.clientUserId == request.auth.uid);

      allow create: if request.auth != null
                    && request.resource.data.providerId == request.auth.uid;

      // Only the provider can update directly. The client-join write goes
      // through the server (POST /api/projects/:id/join, admin SDK), which
      // validates the seat before writing — clients never touch this doc.
      allow update: if request.auth != null
                    && resource.data.providerId == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.providerId == request.auth.uid;
    }

    // ── Expenses ──────────────────────────────────────────────
    // Read: auth required + must be project participant
    // Write: only the provider who owns the expense
    match /expenses/{expenseId} {
      allow read: if request.auth != null
                  && isProjectParticipant(resource.data.projectId);

      allow create: if request.auth != null
                    && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.providerId == request.auth.uid;
    }

    // ── Collaborators (private, provider-scoped) ──────────────
    // Provider-owned profiles of subcontractors (albanil, electricista,
    // etc.). No client access. When collaborators get their own auth,
    // extend reads to include the collaborator themselves.
    match /collaborators/{collaboratorId} {
      allow read: if request.auth != null
                  && resource.data.providerId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.providerId == request.auth.uid;
    }

    // ── Deliveries ────────────────────────────────────────────
    // Same pattern as expenses: read for participants, write for provider
    match /deliveries/{deliveryId} {
      allow read: if request.auth != null
                  && isProjectParticipant(resource.data.projectId);

      allow create: if request.auth != null
                    && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.providerId == request.auth.uid;
    }

    // ── Categories ────────────────────────────────────────────
    // Read: auth required. Categories are provider-scoped labels/colors
    // (not sensitive financial data) but we still require authentication.
    // Clients read the provider's categories via authenticated queries.
    // Write: only the owning provider.
    match /categories/{categoryId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // ── Providers (private) ────────────────────────────────────
    // Each user can only read/write their own provider profile
    // Doc ID = Firebase Auth UID, so we match directly
    match /providers/{userId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId;
      allow delete: if false;
    }

    // ── WhatsApp Links (private) ──────────────────────────────
    // Only the owning user can read/write their linking state
    match /whatsappLinks/{linkId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // ── Vendors (private) ─────────────────────────────────────
    // Only the owning user can manage their vendor list
    match /vendors/{vendorId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // ── FAQ (public, read-only from client) ────────────────────
    // Written only by server Admin SDK (seed script)
    match /faq/{faqId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Recipients (private) ──────────────────────────────────
    // Only the owning user can manage their recipient list
    match /recipients/{recipientId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }
  }
}
