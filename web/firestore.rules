rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Projects ──────────────────────────────────────────────
    // Provider (auth'd): full CRUD on own projects
    // Client (auth'd): read projects where clientUserId matches
    // Public: read allowed for shareToken lookup flow
    //   shareTokens are UUIDs — not enumerable or guessable
    match /projects/{projectId} {
      // Public read: needed for shareToken-based join/view flows.
      // Authenticated users who haven't joined yet (not provider or client)
      // would be denied if we required auth scoping on reads.
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.providerId == request.auth.uid;
    }

    // ── Expenses ──────────────────────────────────────────────
    // Provider (auth'd): full CRUD on own expenses
    // Read: open (authenticated clients need access via projectId queries)
    //   projectIds are Firestore auto-IDs — not guessable
    match /expenses/{expenseId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.providerId == request.auth.uid;
    }

    // ── Deliveries ────────────────────────────────────────────
    // Same pattern as expenses: provider owns, open read
    match /deliveries/{deliveryId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.providerId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.providerId == request.auth.uid;
    }

    // ── Categories ────────────────────────────────────────────
    // Provider (auth'd): full CRUD on own categories
    // Read: open (authenticated clients need provider's categories)
    match /categories/{categoryId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // ── WhatsApp Links (private) ──────────────────────────────
    // Only the owning user can read/write their linking state
    match /whatsappLinks/{linkId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // ── Vendors (private) ─────────────────────────────────────
    // Only the owning user can manage their vendor list
    match /vendors/{vendorId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // ── Recipients (private) ──────────────────────────────────
    // Only the owning user can manage their recipient list
    match /recipients/{recipientId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }
  }
}
